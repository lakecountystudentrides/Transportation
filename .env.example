# Copy this file to .env and fill in real values.
# .env is git-ignored — real secrets never get committed.
# Names only below, no real values, safe to keep in the repo.

# --- Stripe (test mode first, live mode only after Step 12 below) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Maps Platform (address autocomplete + distance pricing) ---
GOOGLE_MAPS_API_KEY=

# --- Cloudflare (only needed if we automate DNS/Pages via API instead of the dashboard) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- Site config ---
SITE_URL=
