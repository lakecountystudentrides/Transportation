# Copy this file to .env and fill in real values.
# .env is git-ignored — real secrets never get committed.
# Names only below, no real values, safe to keep in the repo.

# --- Stripe (test mode first, live mode only after Step 12 below) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Maps Platform (address autocomplete + distance pricing) ---
GOOGLE_MAPS_API_KEY=

# --- Dispatch origin (private — used server-side only to calculate the
# beyond-5-mile overage in docs/03-pricing.md; NEVER displayed on the
# site or committed with a real value. Set the real address only in
# Cloudflare Pages' environment variable dashboard, not in this file.) ---
DISPATCH_ORIGIN_ADDRESS=

# --- Cloudflare (only needed if we automate DNS/Pages via API instead of the dashboard) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- Trip storage (Cloudflare KV) ---
# This is a BINDING, not an env var with a text value -- create a KV namespace in
# Cloudflare Pages (Settings -> Functions -> KV namespace bindings), name the
# binding TRIPS_KV, and it becomes available to the Functions automatically.
# Nothing to fill in here; listed for visibility only.

# --- Pickup/drop-off email notifications (Resend) ---
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# --- Driver dashboard access ---
# This is YOUR owner/master code -- it still works at /driver.html, and it's
# also what unlocks /manage-drivers.html, where you add individual drivers
# and get each one their own access code (stored in TRIPS_KV, no separate
# env var needed per driver). Pick something long and random, not a real
# password you reuse elsewhere, and don't hand this one out to drivers --
# give them their individual code from /manage-drivers.html instead.
DRIVER_ACCESS_TOKEN=

# --- Parent portal sessions ---
# Signs the login cookie for /parent-portal.html (functions/_lib/session.js).
# Pick a long random string, different from DRIVER_ACCESS_TOKEN. Parent accounts
# themselves (email + hashed password) are stored in the TRIPS_KV namespace above,
# no separate KV binding needed.
PARENT_SESSION_SECRET=

# --- Site config ---
SITE_URL=
